# ==============================================================================
# ASHIVAM TECHNOLOGIES BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL & Allowed CORS Origins (comma-separated for multiples)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ashivam-tec-h.vercel.app

# MongoDB Connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/ashivam_technologies

# JSON Web Token Configuration
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_EXPIRES_IN=1h

# Rate Limiting Configuration
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=900000
PUBLIC_FORM_RATE_LIMIT=10
PUBLIC_FORM_RATE_WINDOW_MS=900000
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_WINDOW_MS=900000

# SMTP / Email Configuration (Optional for development, required for production emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@ashivamtechnologies.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=Ashivam Technologies <no-reply@ashivamtechnologies.com>
NOTIFICATION_RECIPIENT=contact@ashivamtechnologies.com

# Initial Superadmin Configuration (for create-admin script)
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Persistent Object Storage (Required in production: 's3', optional in local development: 'local')
STORAGE_PROVIDER=local
S3_BUCKET=your-private-resume-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
