# ==============================================================================
# ASHIVAM TECHNOLOGIES - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to your production hosting provider's Environment Secrets panel.
# DO NOT commit real secrets or production .env files to source control.
# ==============================================================================

# 1. Server Environment
NODE_ENV=production
PORT=5000

# 2. CORS & Client Origins (Allowed frontend domains)
CLIENT_URL=https://ashivam-tec-h.vercel.app
ALLOWED_ORIGINS=https://ashivam-tec-h.vercel.app,https://ashivamtechnologies.com,https://www.ashivamtechnologies.com

# 3. Production MongoDB Atlas Connection (TLS/SRV format with dedicated user)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/ashivam_technologies?retryWrites=true&w=majority&appName=AshivamCluster
MONGODB_URI=mongodb+srv://ashivam_prod_app:<STRONG_DB_PASSWORD>@cluster0.ashivam.mongodb.net/ashivam_technologies?retryWrites=true&w=majority

# 4. JSON Web Token & Sliding Session Secrets (Generate distinct keys: openssl rand -base64 48)
JWT_SECRET=replace-with-minimum-64-character-cryptographically-secure-access-secret
JWT_REFRESH_SECRET=replace-with-distinct-minimum-64-character-production-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# 5. Rate Limiting Configurations
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=900000
PUBLIC_FORM_RATE_LIMIT=10
PUBLIC_FORM_RATE_WINDOW_MS=900000
GLOBAL_RATE_LIMIT=100
GLOBAL_RATE_WINDOW_MS=900000

# 6. Production SMTP Credentials (SendGrid, Mailgun, Amazon SES, or Google Workspace)
COMPANY_NOTIFICATION_EMAIL=team.ashivam@gmail.com
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_production_sendgrid_api_key_here
EMAIL_FROM=Ashivam Technologies <teamashivam@gmail.com>
ALERT_EMAIL=team.ashivam@gmail.com
NOTIFICATION_RECIPIENT=team.ashivam@gmail.com

# 7. Initial Superadmin Seed Account (Only needed on first database seed)
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PASSWORD=replace-with-extremely-strong-production-admin-passphrase!
