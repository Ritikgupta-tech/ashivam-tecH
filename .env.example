# Ashivam Technologies Frontend Environment Variables
# Copy to .env.local for local development overrides

# Local Development (Default):
# The Vite dev server proxies /api to the local backend on http://localhost:5000 by default.
VITE_API_URL=/api/v1

# Optional: Override backend proxy target if running backend on a different port
# VITE_BACKEND_TARGET=http://localhost:5000

# Production Deployment (Vercel):
# Set in Vercel project environment settings to point to the live cloud backend
# VITE_API_URL=https://ashivam-tech.onrender.com/api/v1
